#!/bin/sh
# GPG-backed password store. POSIX shell.
umask 077
: "${HOME:?HOME is not set}"

# Resolve the directory containing this script so helper programs work
# regardless of the caller's current working directory.
case "$0" in
    */*) PASS_SCRIPT=$0 ;;
    *) PASS_SCRIPT=$(command -v "$0" 2>/dev/null || printf '%s' "$0") ;;
esac
PASS_DIR=$(CDPATH= cd -P "$(dirname "$PASS_SCRIPT")" 2>/dev/null && pwd) ||
    PASS_DIR=.

DB=${PASS_DB:-$HOME/passwords.gpg}
TAB=$(printf '\t')
EDITOR_CMD=${VISUAL:-${EDITOR:-vi}}
WORK= NEWDB= DB_WAS_OLD=no
CACHE_SECONDS=300
CACHE_DIR= CACHE_DATABASE= CACHE_STATE= CACHE_CLEANER_PID=
ECHO_DISABLED=no

restore_echo() {
    if [ "$ECHO_DISABLED" = yes ]; then
        stty echo 2>/dev/null || :
        ECHO_DISABLED=no
    fi
}
cleanup() {
    restore_echo
    [ -z "$WORK" ] || [ ! -d "$WORK" ] || rm -rf "$WORK"
    [ -z "$NEWDB" ] || [ ! -f "$NEWDB" ] || rm -f "$NEWDB"
}
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
trap cleanup 0
trap 'exit 1' HUP INT TERM

# Tell gpg-agent which terminal should receive pinentry prompts.
prepare_pinentry() {
    if [ -n "${GPG_TTY:-}" ]; then
        export GPG_TTY
    else
        GPG_TTY=$(sh -c 'tty < /dev/tty' 2>/dev/null) || GPG_TTY=
        [ -z "$GPG_TTY" ] || export GPG_TTY
    fi
    if command -v gpg-connect-agent >/dev/null 2>&1; then
        printf 'updatestartuptty\n/bye\n' |
            gpg-connect-agent --quiet >/dev/null 2>&1 || :
    fi
}

agent_clear_passphrase() {
    command -v gpg-connect-agent >/dev/null 2>&1 || return 0
    printf 'CLEAR_PASSPHRASE pass:master\n/bye\n' |
        gpg-connect-agent --quiet >/dev/null 2>&1 || :
}

prompt_master_password() {
    prompt_mode=$1
    case "$prompt_mode" in
        new)
            agent_clear_passphrase
            agent_command='GET_PASSPHRASE --data --repeat=1 pass:master X Enter+new+database+password X'
            ;;
        retry)
            agent_command='GET_PASSPHRASE --data pass:master Incorrect+database+password Enter+database+password X'
            ;;
        *)
            agent_command='GET_PASSPHRASE --data pass:master X Enter+database+password X'
            ;;
    esac
    prepare_pinentry
    pass_tmp=$(mktemp "$WORK/passphrase.XXXXXX") ||
        die "Cannot create RAM passphrase file."
    if ! {
        printf '%s\n' "$agent_command"
        printf '/bye\n'
    } | gpg-connect-agent --quiet --decode 2>/dev/null |
        sed -n 's/^D //p' > "$pass_tmp"; then
        rm -f "$pass_tmp"
        die "Pinentry failed while requesting the database password."
    fi
    [ -s "$pass_tmp" ] || {
        rm -f "$pass_tmp"
        die "Pinentry was cancelled or returned an empty database password."
    }
    chmod 600 "$pass_tmp" || die "Cannot secure RAM passphrase file."
    mv -f "$pass_tmp" "$WORK/passphrase" ||
        die "Cannot install RAM passphrase file."
    chmod 600 "$WORK/passphrase" || die "Cannot secure database passphrase."
    cache_touch
}

usage() {
    cat <<'EOF'
Usage:
  pass init
  pass open
  pass close
  pass rekey
  pass add
  pass edit TITLE[/USERNAME]
  pass show [TITLE/USERNAME]
  pass copy [--username|-u | --password|-p | --notes|-n | --url|-l] TITLE/USERNAME
  pass delete TITLE/USERNAME
  pass otp TITLE/USERNAME
  pass otp add TITLE/USERNAME
  pass otp remove TITLE/USERNAME
  pass qr TITLE/USERNAME
  pass generate [LENGTH] [OPTIONS]

Generate options:
  --length N
  --no-upper
  --no-lower
  --no-numbers
  --no-symbols

Examples:
  pass init
  pass add
  pass show GitHub/myuser
  pass copy GitHub/myuser
  pass copy --username GitHub/myuser
  pass copy --notes GitHub/myuser
  pass copy --url GitHub/myuser
  pass edit GitHub/myuser
  pass otp add GitHub/myuser
  pass otp GitHub/myuser
  pass otp remove GitHub/myuser
  pass qr GitHub/myuser
  pass generate 32 --no-symbols
  pass rekey
  pass open
  pass close
EOF
    exit 1
}

make_work() {
    [ -n "$WORK" ] && return 0
    [ -d /dev/shm ] && [ -w /dev/shm ] ||
        die "/dev/shm is not available or writable."
    WORK=$(mktemp -d /dev/shm/pass.XXXXXX) ||
        die "Cannot create temporary directory in /dev/shm."
    chmod 700 "$WORK" || die "Cannot secure temporary directory."
}

cache_init() {
    [ -d /dev/shm ] && [ -w /dev/shm ] ||
        die "/dev/shm is not available or writable."
    [ -r "$PASS_DIR/pass-cache-cleaner" ] ||
        die "Cache helper not found: $PASS_DIR/pass-cache-cleaner"
    cache_uid=$(id -u 2>/dev/null) || die "Cannot determine user ID."

    # Remove a cache from the former lock-directory/last-used timer design.
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ "$XDG_RUNTIME_DIR" != /dev/shm ]; then
        old_cache=$XDG_RUNTIME_DIR/pass-cache-$cache_uid
        if [ -d "$old_cache" ]; then
            old_info=$(ls -ldn "$old_cache" 2>/dev/null) || old_info=
            old_kind=$(printf '%s\n' "$old_info" | cut -c1)
            old_owner=$(printf '%s\n' "$old_info" | awk '{print $3}')
            if [ "$old_kind" = d ] && [ "$old_owner" = "$cache_uid" ]; then
                rm -f "$old_cache/database" "$old_cache/meta" \
                    "$old_cache/passphrase" "$old_cache/last-used" 2>/dev/null || :
                rmdir "$old_cache" 2>/dev/null || :
            fi
        fi
    fi

    CACHE_DIR=/dev/shm/pass-cache-$cache_uid
    if [ ! -d "$CACHE_DIR" ]; then
        (umask 077 && mkdir "$CACHE_DIR") 2>/dev/null ||
            die "Cannot create RAM cache directory."
    fi
    cache_info=$(ls -ldn "$CACHE_DIR" 2>/dev/null) ||
        die "Cannot inspect RAM cache directory."
    cache_kind=$(printf '%s\n' "$cache_info" | cut -c1)
    cache_owner=$(printf '%s\n' "$cache_info" | awk '{print $3}')
    if [ "$cache_kind" != d ] || [ "$cache_owner" != "$cache_uid" ]; then
        die "RAM cache directory is not owned by the current user."
    fi
    chmod 700 "$CACHE_DIR" 2>/dev/null ||
        die "Cannot secure RAM cache directory."

    CACHE_DATABASE=$CACHE_DIR/database
    CACHE_STATE=$CACHE_DIR/state
    CACHE_CLEANER_PID=$CACHE_DIR/cleaner.pid

    # Stop any cleaner left by the previous implementation.
    if [ -f "$CACHE_DIR/cleaner.lock/pid" ]; then
        old_cleaner_pid=$(cat "$CACHE_DIR/cleaner.lock/pid" 2>/dev/null)
        case "$old_cleaner_pid" in
            ''|*[!0-9]*) ;;
            *) kill "$old_cleaner_pid" 2>/dev/null || : ;;
        esac
    fi
    rm -rf "$CACHE_DIR/cleaner.lock" 2>/dev/null || :
    # Retire the former separate meta/passphrase/last-used files.
    rm -f "$CACHE_DIR/meta" "$CACHE_DIR/passphrase" \
        "$CACHE_DIR/last-used" 2>/dev/null || :
}
cache_clear() {
    [ -z "$CACHE_DIR" ] && return 0

    if [ -f "$CACHE_CLEANER_PID" ]; then
        cleaner_pid=$(cat "$CACHE_CLEANER_PID" 2>/dev/null)
        case "$cleaner_pid" in
            ''|*[!0-9]*) ;;
            *) kill "$cleaner_pid" 2>/dev/null || : ;;
        esac
    fi

    rm -f "$CACHE_DATABASE" "$CACHE_STATE" "$CACHE_CLEANER_PID" \
        "$CACHE_DIR"/database.* "$CACHE_DIR"/state.* \
        "$CACHE_DIR/meta" "$CACHE_DIR/passphrase" \
        "$CACHE_DIR"/meta.* "$CACHE_DIR"/passphrase.* \
        "$CACHE_DIR/last-used" 2>/dev/null || :
    rm -rf "$CACHE_DIR/cleaner.lock" 2>/dev/null || :
    agent_clear_passphrase
}

cache_signature() {
    cksum < "$DB" | awk '{print $1 ":" $2}'
}

start_cache_cleaner() {
    [ -n "$CACHE_DIR" ] || return 0

    # Every active use replaces the previous one-shot timer.
    if [ -f "$CACHE_CLEANER_PID" ]; then
        cleaner_pid=$(cat "$CACHE_CLEANER_PID" 2>/dev/null)
        case "$cleaner_pid" in
            ''|*[!0-9]*) ;;
            *) kill "$cleaner_pid" 2>/dev/null || : ;;
        esac
    fi
    rm -f "$CACHE_CLEANER_PID" 2>/dev/null || :

    nohup sh "$PASS_DIR/pass-cache-cleaner" "$CACHE_DIR" \
        "$CACHE_SECONDS" </dev/null >/dev/null 2>&1 &
    cleaner_pid=$!
    if ! printf '%s\n' "$cleaner_pid" > "$CACHE_CLEANER_PID"; then
        kill "$cleaner_pid" 2>/dev/null || :
        rm -f "$CACHE_CLEANER_PID" 2>/dev/null || :
        return 0
    fi
    chmod 600 "$CACHE_CLEANER_PID" 2>/dev/null || :
}

cache_touch() {
    [ -n "$CACHE_DIR" ] || return 0
    start_cache_cleaner
}

close_cache() {
    cache_init
    cache_clear
    rmdir "$CACHE_DIR" 2>/dev/null || :
    printf 'RAM cache cleared.\n'
}
cache_read() {
    expected_signature=$1

    # The cleaner PID is the cache's idle-time lease.
    if [ ! -s "$CACHE_STATE" ] || [ ! -s "$CACHE_CLEANER_PID" ]; then
        cache_clear
        return 1
    fi
    IFS= read -r cleaner_pid < "$CACHE_CLEANER_PID" || {
        cache_clear
        return 1
    }
    case "$cleaner_pid" in
        ''|*[!0-9]*) cache_clear; return 1 ;;
    esac
    kill -0 "$cleaner_pid" 2>/dev/null || {
        cache_clear
        return 1
    }

    [ -f "$CACHE_DATABASE" ] || {
        cache_clear
        return 1
    }
    IFS= read -r cached_signature < "$CACHE_STATE" || {
        cache_clear
        return 1
    }
    # The first line of state is the encrypted-database checksum; the rest
    # is the cached symmetric passphrase. Keep the passphrase available when
    # the DB checksum changed so decrypt_db can try it before prompting again.
    sed '1d' "$CACHE_STATE" > "$WORK/passphrase" 2>/dev/null || return 1
    [ -s "$WORK/passphrase" ] || {
        cache_clear
        return 1
    }
    chmod 600 "$WORK/passphrase" 2>/dev/null || {
        cache_clear
        return 1
    }
    [ "$cached_signature" = "$expected_signature" ] || return 1
    cp "$CACHE_DATABASE" "$WORK/decrypted" 2>/dev/null || return 1
    chmod 600 "$WORK/decrypted" 2>/dev/null || return 1
    DB_WAS_OLD=no
    parse_header
    cp "$WORK/decrypted" "$WORK/database" || return 1
    chmod 600 "$WORK/database" || return 1

    # The cache is valid and has just been used; restart the idle timer.
    cache_touch
    return 0
}
cache_write() {
    expected_signature=$1
    [ -n "$CACHE_DIR" ] || return 0
    [ -f "$WORK/database" ] && [ -s "$WORK/passphrase" ] || return 0
    current_signature=$(cache_signature 2>/dev/null) || return 0
    [ "$current_signature" = "$expected_signature" ] || return 0

    cache_tmp_db=$(mktemp "$CACHE_DIR/database.XXXXXX") || return 0
    if ! cp "$WORK/database" "$cache_tmp_db" ||
       ! chmod 600 "$cache_tmp_db"; then
        rm -f "$cache_tmp_db"
        return 0
    fi
    mv -f "$cache_tmp_db" "$CACHE_DATABASE" || {
        rm -f "$cache_tmp_db"
        return 0
    }

    # Store the DB signature and passphrase together to avoid a separate meta file.
    cache_tmp_state=$(mktemp "$CACHE_DIR/state.XXXXXX") || return 0
    if ! {
        printf '%s\n' "$expected_signature"
        cat "$WORK/passphrase"
    } > "$cache_tmp_state" || ! chmod 600 "$cache_tmp_state"; then
        rm -f "$cache_tmp_state"
        cache_clear
        return 0
    fi
    mv -f "$cache_tmp_state" "$CACHE_STATE" || {
        rm -f "$cache_tmp_state"
        cache_clear
        return 0
    }
    cache_touch
}
has_legacy_records() {
    LC_ALL=C awk '
    NR == 1 {next}
    {
        fields=1; escaped=0
        for (i=1; i<=length($0); i++) {
            c=substr($0,i,1)
            if (escaped) escaped=0
            else if (c=="\\") escaped=1
            else if (c=="|") fields++
        }
        if (fields==5) old=1
        else if (fields!=6) bad=1
    }
    END {
        if (bad) exit 2
        if (old) exit 0
        exit 1
    }' "$1"
}

file_to_var() {
    file_value=$(cat "$1"; printf '.') || die "Cannot read temporary field."
    file_value=${file_value%.}
}

escape_file() {
    LC_ALL=C awk '
    {
        if (NR>1) printf "\\n"
        for (i=1; i<=length($0); i++) {
            c=substr($0,i,1)
            if (c=="\\") printf "\\\\"
            else if (c=="|") printf "\\|"
            else if (c=="\r") printf "\\r"
            else if (c=="\t") printf "\\t"
            else printf "%s",c
        }
    }' "$1"
}

encode_value() {
    printf '%s' "$1" > "$WORK/value" ||
        die "Cannot prepare field for encoding."
    escape_file "$WORK/value"
}

decode_record() {
    printf '%s\n' "$1" > "$WORK/record" || die "Cannot prepare record."
    : > "$WORK/f1"; : > "$WORK/f2"; : > "$WORK/f3"
    : > "$WORK/f4"; : > "$WORK/f5"; : > "$WORK/f6"

    LC_ALL=C awk \
        -v f1="$WORK/f1" -v f2="$WORK/f2" \
        -v f3="$WORK/f3" -v f4="$WORK/f4" \
        -v f5="$WORK/f5" -v f6="$WORK/f6" '
    function put(s) {
        if (field==1) printf "%s",s >> f1
        else if (field==2) printf "%s",s >> f2
        else if (field==3) printf "%s",s >> f3
        else if (field==4) printf "%s",s >> f4
        else if (field==5) printf "%s",s >> f5
        else if (field==6) printf "%s",s >> f6
        else bad=1
    }
    {
        field=1; escaped=0
        for (i=1; i<=length($0); i++) {
            c=substr($0,i,1)
            if (escaped) {
                if (c=="n") put("\n")
                else if (c=="r") put("\r")
                else if (c=="t") put("\t")
                else if (c=="\\" || c=="|") put(c)
                else {put("\\"); put(c)}
                escaped=0
            } else if (c=="\\") escaped=1
            else if (c=="|") field++
            else put(c)
        }
        if (escaped) bad=1
    }
    END {
        close(f1); close(f2); close(f3)
        close(f4); close(f5); close(f6)
        if (bad || (field!=5 && field!=6)) exit 1
        if (field==5) exit 2
    }' "$WORK/record"
    decode_status=$?
    case "$decode_status" in
        0) record_legacy=no ;;
        2) record_legacy=yes ;;
        *) die "Invalid PASSDB record (expected five or six escaped fields)." ;;
    esac

    file_to_var "$WORK/f1"; title=$file_value
    file_to_var "$WORK/f2"; username=$file_value
    file_to_var "$WORK/f3"; password=$file_value
    file_to_var "$WORK/f4"; totp=$file_value
    if [ "$record_legacy" = yes ]; then
        : > "$WORK/url"
        cp "$WORK/f5" "$WORK/notes" || die "Cannot prepare notes field."
    else
        cp "$WORK/f5" "$WORK/url" || die "Cannot prepare URL field."
        cp "$WORK/f6" "$WORK/notes" || die "Cannot prepare notes field."
    fi
    file_to_var "$WORK/url"; url=$file_value
}

append_record() {
    output_file=$1
    {
        escape_file "$WORK/f1"; printf '|'
        escape_file "$WORK/f2"; printf '|'
        escape_file "$WORK/f3"; printf '|'
        escape_file "$WORK/f4"; printf '|'
        escape_file "$WORK/f5"; printf '|'
        escape_file "$WORK/f6"; printf '\n'
    } >> "$output_file" || die "Cannot write database record."
}

append_current_record() {
    output_file=$1
    printf '%s' "$title" > "$WORK/f1" || die "Cannot prepare title."
    printf '%s' "$username" > "$WORK/f2" || die "Cannot prepare username."
    printf '%s' "$password" > "$WORK/f3" || die "Cannot prepare password."
    printf '%s' "$totp" > "$WORK/f4" || die "Cannot prepare TOTP field."
    printf '%s' "$url" > "$WORK/f5" || die "Cannot prepare URL field."
    [ -f "$WORK/notes" ] || : > "$WORK/notes"
    cp "$WORK/notes" "$WORK/f6" || die "Cannot prepare notes."
    append_record "$output_file"
}

parse_header() {
    header=$(sed -n '1p' "$WORK/decrypted")
    case "$header" in
        "PASSDB$TAB"*) recipient=${header#PASSDB"$TAB"} ;;
        "PASSDB "*) recipient=${header#PASSDB } ;;
        "PASSDB1"*|"PASSDB2"*)
            die "Legacy Base64 database: migrate it with the previous pass script first."
            ;;
        *) die "Invalid database header." ;;
    esac
}

check_db() {
    [ -f "$DB" ] || die "No database. Run: pass init"
}

decrypt_db() {
    check_db
    make_work
    cache_init
    db_signature=$(cache_signature) || die "Cannot calculate database checksum."
    cache_read "$db_signature" && return 0

    attempt=1
    while :; do
        [ -s "$WORK/passphrase" ] || prompt_master_password unlock
        if gpg --batch --quiet --pinentry-mode loopback \
            --passphrase-file "$WORK/passphrase" \
            --decrypt --output "$WORK/decrypted" "$DB"; then
            break
        fi
        rm -f "$WORK/decrypted" "$WORK/passphrase"
        cache_clear
        attempt=$((attempt + 1))
        [ "$attempt" -le 3 ] ||
            die "Unable to decrypt database after three password attempts."
        prompt_master_password retry
    done
    chmod 600 "$WORK/decrypted" || die "Cannot secure decrypted database."
    parse_header

    if has_legacy_records "$WORK/decrypted"; then
        legacy_status=0
    else
        legacy_status=$?
    fi
    case "$legacy_status" in
        0)
            printf 'PASSDB\t%s\n' "$recipient" > "$WORK/database" ||
                die "Cannot prepare database header."
            sed '1d' "$WORK/decrypted" > "$WORK/raw-records" ||
                die "Cannot read database records."
            DB_WAS_OLD=yes
            while IFS= read -r record || [ -n "$record" ]; do
                [ -n "$record" ] || continue
                decode_record "$record"
                append_current_record "$WORK/database"
            done < "$WORK/raw-records"
            ;;
        1)
            cp "$WORK/decrypted" "$WORK/database" ||
                die "Cannot prepare database."
            DB_WAS_OLD=no
            ;;
        *) die "Invalid PASSDB record format." ;;
    esac
    chmod 600 "$WORK/database" || die "Cannot secure database."
    cache_write "$db_signature"
}

encrypt_db() {
    [ -s "$WORK/passphrase" ] ||
        die "Database password is not available. Unlock the database again."
    NEWDB=$(mktemp "$DB.tmp.XXXXXX") ||
        die "Cannot create encrypted database temporary file."
    chmod 600 "$NEWDB" || die "Cannot secure encrypted temporary file."

    if ! gpg --batch --quiet --yes --pinentry-mode loopback \
        --passphrase-file "$WORK/passphrase" \
        --compress-algo bzip2 \
        --compress-level 9 \
        --symmetric --cipher-algo AES256 \
        --output "$NEWDB" "$1"; then
        rm -f "$NEWDB"
        NEWDB=
        return 1
    fi

    if ! chmod 600 "$NEWDB" || ! mv -f "$NEWDB" "$DB"; then
        rm -f "$NEWDB"
        NEWDB=
        return 1
    fi
    NEWDB=
    if [ "$1" != "$WORK/database" ]; then
        cp "$1" "$WORK/database" || die "Cannot update decrypted cache."
    fi
    chmod 600 "$WORK/database" || die "Cannot secure decrypted cache."
    DB_WAS_OLD=no
    new_signature=$(cache_signature) || die "Cannot calculate database checksum."
    cache_write "$new_signature"
}

ask_new_database_password() {
    prompt_master_password new
}

init_db() {
    [ "$#" -eq 0 ] || usage
    [ ! -e "$DB" ] || die "$DB already exists."
    make_work
    cache_init
    ask_new_database_password
    printf 'PASSDB\tSYMMETRIC\n' > "$WORK/database" ||
        die "Cannot create database header."
    chmod 600 "$WORK/database" || die "Cannot secure database."
    encrypt_db "$WORK/database" || die "GPG symmetric encryption failed."
    printf 'Initialized symmetric encrypted database: %s\n' "$DB"
}

rekey_db() {
    [ "$#" -eq 0 ] || usage
    decrypt_db
    # GPG-agent pinentry requests and confirms the replacement password.
    cp "$WORK/passphrase" "$WORK/old-passphrase" ||
        die "Cannot preserve current database password."
    ask_new_database_password
    if ! encrypt_db "$WORK/database"; then
        cp "$WORK/old-passphrase" "$WORK/passphrase" || :
        agent_clear_passphrase
        cache_touch
        die "Unable to re-encrypt database; the old database password was restored."
    fi
    printf 'Database password changed.\n'
}

parse_spec() {
    case "$1" in
        */*) title=${1%%/*}; username=${1#*/} ;;
        *) title=$1; username= ;;
    esac
    [ -n "$title" ] || die "Title cannot be empty."
    case "$title" in */*) die "Title cannot contain /." ;; esac
}

record_match_action() {
    action=$1
    database_file=$2
    enc_title=$3
    enc_user=$4
    printf '%s\n%s\n' "$enc_title" "$enc_user" > "$WORK/key" ||
        die "Cannot prepare search key."
    LC_ALL=C awk -v keyfile="$WORK/key" -v action="$action" '
    function first_sep(s,start,    i,c,esc) {
        esc=0
        for (i=start; i<=length(s); i++) {
            c=substr(s,i,1)
            if (esc) {esc=0; continue}
            if (c=="\\") {esc=1; continue}
            if (c=="|") return i
        }
        return length(s)+1
    }
    BEGIN {
        getline t < keyfile
        getline u < keyfile
        close(keyfile)
    }
    NR==1 {if (action=="remove") print; next}
    {
        p=first_sep($0,1)
        a=substr($0,1,p-1)
        q=first_sep($0,p+1)
        b=substr($0,p+1,q-p-1)
        matched=(tolower(a)==tolower(t) && tolower(b)==tolower(u))
        if (action=="find" && matched) {print; exit}
        if (action=="exists" && matched) {found=1; exit}
        if (action=="remove" && !matched) print
    }
    END {if (action=="exists") exit !found}
    ' "$database_file"
}

find_entry() {
    enc_title=$(encode_value "$title")
    enc_user=$(encode_value "$username")
    record_match_action find "$WORK/database" "$enc_title" "$enc_user"
}
entry_exists_in() {
    database_file=$1
    enc_title=$(encode_value "$title")
    enc_user=$(encode_value "$username")
    record_match_action exists "$database_file" "$enc_title" "$enc_user" >/dev/null
}
remove_record() {
    record_match_action remove "$WORK/database" "$1" "$2" > "$WORK/updated" ||
        die "Cannot update database records."
}
store_record() {
    key_title=${1-$title}
    key_username=${2-$username}
    enc_title=$(encode_value "$key_title")
    enc_user=$(encode_value "$key_username")
    remove_record "$enc_title" "$enc_user"
    append_current_record "$WORK/updated"
    encrypt_db "$WORK/updated" || die "GPG symmetric encryption failed."
}

read_secret() {
    printf '%s' "$1"
    if [ -t 0 ]; then
        ECHO_DISABLED=yes
        stty -echo 2>/dev/null || {
            ECHO_DISABLED=no; die "Cannot disable terminal echo."
        }
        IFS= read -r secret
        read_status=$?
        restore_echo
        [ "$read_status" -eq 0 ] || die "Unable to read secret."
    else
        IFS= read -r secret || die "Unable to read secret."
    fi
    printf '\n'
}

ask_yes_no() {
    printf '%s [Y/n]: ' "$1"
    IFS= read -r answer || answer=
    case "$answer" in n|N|no|NO) return 1 ;; *) return 0 ;; esac
}

generate_password() {
    length=25
    upper=yes lower=yes numbers=yes symbols=yes
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --length)
                shift
                [ "$#" -gt 0 ] || die "Missing value for --length."
                length=$1
                ;;
            --no-upper) upper=no ;;
            --no-lower) lower=no ;;
            --no-numbers) numbers=no ;;
            --no-symbols) symbols=no ;;
            --*) die "Unknown generate option: $1" ;;
            *) length=$1 ;;
        esac
        shift
    done
    case "$length" in ''|*[!0-9]*) die "Invalid password length." ;; esac
    [ "${#length}" -le 4 ] || die "Password length is too large (maximum 4096)."
    [ "$length" -gt 0 ] || die "Password length must be positive."
    [ "$length" -le 4096 ] || die "Password length is too large (maximum 4096)."

    chars=
    [ "$upper" = yes ] && chars=${chars}A-Z
    [ "$lower" = yes ] && chars=${chars}a-z
    [ "$numbers" = yes ] && chars=${chars}0-9
    [ "$symbols" = yes ] && chars="${chars}!@#\$%&*()_+=:,.?|-"
    [ -n "$chars" ] || die "At least one character set must be enabled."
    LC_ALL=C tr -dc "$chars" < /dev/urandom | dd bs=1 count="$length" 2>/dev/null
    printf '\n'
}

generate_password_for_add() {
    printf 'Password length [25]: '
    IFS= read -r length || die "Unable to read password length."
    length=${length:-25}
    upper=yes lower=yes numbers=yes symbols=yes
    printf 'This password will contain uppercase letters, lowercase letters, numbers, and symbols. Is this OK? [Y/n] '
    IFS= read -r answer || answer=
    case "$answer" in
        n|N|no|NO)
            printf '\nCharacter sets you can exclude:\n'
            printf '  1) Uppercase letters\n  2) Lowercase letters\n'
            printf '  3) Numbers\n  4) Symbols\n'
            printf 'Enter exclusions (examples: 12 or 1 2; press Enter for none): '
            IFS= read -r exclusions || exclusions=
            compact=$(printf '%s' "$exclusions" | tr -d " ,$TAB")
            case "$compact" in *[!1234]*) die "Invalid exclusion '$exclusions'. Use only 1, 2, 3, or 4." ;; esac
            index=1
            while [ "$index" -le "${#compact}" ]; do
                choice=$(printf '%s' "$compact" | cut -c "$index")
                case "$choice" in
                    1) upper=no ;; 2) lower=no ;;
                    3) numbers=no ;; 4) symbols=no ;;
                esac
                index=$((index+1))
            done
            ;;
    esac
    set -- "$length"
    [ "$upper" = no ] && set -- "$@" --no-upper
    [ "$lower" = no ] && set -- "$@" --no-lower
    [ "$numbers" = no ] && set -- "$@" --no-numbers
    [ "$symbols" = no ] && set -- "$@" --no-symbols
    while :; do
        password=$(generate_password "$@") || die "Password generation failed."
        printf '\nGenerated password:\n%s\n\n' "$password"
        ask_yes_no 'Use this password?' && break
    done
}

add_entry() {
    decrypt_db
    printf 'Title: '
    IFS= read -r title || die "Unable to read title."
    [ -n "$title" ] || die "Title is required."
    case "$title" in */*) die "Title cannot contain /." ;; esac
    printf 'Username: '
    IFS= read -r username || die "Unable to read username."
    entry_exists_in "$WORK/database" &&
        die "That username already exists under this title."

    read_secret 'Password (leave blank to generate): '
    password=$secret
    [ -n "$password" ] || generate_password_for_add
    [ -n "$password" ] || die "Password is required."
    read_secret 'TOTP secret (optional): '
    totp=$secret
    printf 'URL (optional): '
    IFS= read -r url || die "Unable to read URL."
    printf 'Notes (optional; enter a single dot on a line to finish):\n'
    : > "$WORK/notes"
    while IFS= read -r line || [ -n "$line" ]; do
        [ "$line" = '.' ] && break
        printf '%s\n' "$line" >> "$WORK/notes"
    done
    store_record
    printf 'Entry saved: %s/%s\n' "$title" "$username"
}

edit_entry() {
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    original_title=$title
    original_username=$username

    {
        printf 'Title: %s\nUsername: %s\nPassword: %s\nTotp: %s\nURL: %s\nNotes:\n' \
            "$title" "$username" "$password" "$totp" "$url"
        cat "$WORK/notes"
    } > "$WORK/entry" || die "Cannot prepare entry for editing."

    chmod 600 "$WORK/entry" || die "Cannot secure editor file."
    "$EDITOR_CMD" "$WORK/entry" || die "Editor failed."
    # Editing is an active use of the unlocked store; restart its idle timer.
    cache_touch

    # Require only Title and Password.
    for field in Title Password; do
        sed -n '/^Notes:$/q; /^'"$field"': /p' "$WORK/entry" |
            grep -q . || die "Missing $field field."
    done

    # Read fields by label, not line number. Username, Totp and URL
    # may be omitted or left blank.
    edit_field() {
        sed -n '/^Notes:$/q; /^'"$1"': /{
            s/^'"$1"': //
            p
            q
        }' "$WORK/entry"
    }

    title=$(edit_field Title)
    username=$(edit_field Username)
    password=$(edit_field Password)
    totp=$(edit_field Totp)
    url=$(edit_field URL)

    # Notes are everything after the Notes: marker; an empty section is OK.
    grep -q '^Notes:$' "$WORK/entry" ||
        die "Missing Notes field."
    sed -n '/^Notes:$/,$p' "$WORK/entry" |
        sed '1d' > "$WORK/notes" ||
        die "Cannot read edited notes."

    [ -n "$title" ] || die "Title cannot be empty."
    case "$title" in
        */*) die "Title cannot contain /." ;;
    esac
    [ -n "$password" ] || die "Password cannot be empty."

    # Exclude the original record before checking the new title/username key.
    remove_record "$(encode_value "$original_title")" \
        "$(encode_value "$original_username")"
    mv "$WORK/updated" "$WORK/without-old" ||
        die "Cannot prepare database for duplicate checking."

    if entry_exists_in "$WORK/without-old"; then
        die "That username already exists under this title."
    fi

    store_record "$original_title" "$original_username"
    printf 'Entry updated: %s/%s\n' "$title" "$username"
}


open_db() {
    [ "$#" -eq 0 ] || usage
    decrypt_db
    printf 'Database unlocked.\n'
}

close_db() {
    [ "$#" -eq 0 ] || usage
    close_cache
}

show_entry() {
    if [ "$#" -eq 0 ]; then
        decrypt_db
        print_identifiers | LC_ALL=C sort -f
        return 0
    fi
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    printf 'Title: %s\nUsername: %s\nPassword: %s\nTotp: %s\nURL: %s\nNotes:\n' \
        "$title" "$username" "$password" "$totp" "$url"
    cat "$WORK/notes"
    printf '\n'
}
schedule_clipboard_clear() {
    clip_source=$1
    clip_backend=$2
    clip_timeout=${PASS_TIMEOUT:-15}
    case "$clip_timeout" in
        off|OFF|0) return 0 ;;
        ''|*[!0-9]*) clip_timeout=15 ;;
    esac
    [ "$clip_timeout" -gt 0 ] || return 0
    [ -d /dev/shm ] && [ -w /dev/shm ] || return 0
    clip_expected=$(mktemp /dev/shm/pass-clipboard.XXXXXX) || return 0
    clip_current=$clip_expected.current
    if ! cp "$clip_source" "$clip_expected" || ! chmod 600 "$clip_expected"; then
        rm -f "$clip_expected"; return 0
    fi
    : > "$clip_current" || { rm -f "$clip_expected"; return 0; }
    chmod 600 "$clip_current" 2>/dev/null || :

    # Clear only if the clipboard still contains this command's copied value.
    nohup sh -c '
        delay=$1; backend=$2; expected=$3; current=$4
        trap "rm -f \"\$expected\" \"\$current\"" 0 HUP INT TERM
        sleep "$delay" || exit 0
        case "$backend" in
            wl) command -v wl-paste >/dev/null 2>&1 || exit 0
                wl-paste --no-newline > "$current" 2>/dev/null || exit 0 ;;
            xclip) command -v xclip >/dev/null 2>&1 || exit 0
                   xclip -selection clipboard -o > "$current" 2>/dev/null || exit 0 ;;
            xsel) command -v xsel >/dev/null 2>&1 || exit 0
                  xsel --clipboard --output > "$current" 2>/dev/null || exit 0 ;;
            *) exit 0 ;;
        esac
        if cmp -s "$expected" "$current"; then
            case "$backend" in
                wl) printf "" | wl-copy 2>/dev/null ;;
                xclip) printf "" | xclip -selection clipboard -i 2>/dev/null ;;
                xsel) printf "" | xsel --clipboard --input 2>/dev/null ;;
            esac
        fi
    ' sh "$clip_timeout" "$clip_backend" "$clip_expected" "$clip_current" \
        </dev/null >/dev/null 2>&1 &
}

copy_clipboard_file() {
    if command -v wl-copy >/dev/null 2>&1; then
        wl-copy < "$1" || die "Clipboard copy failed."
        schedule_clipboard_clear "$1" wl
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard < "$1" || die "Clipboard copy failed."
        schedule_clipboard_clear "$1" xclip
    elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --input < "$1" || die "Clipboard copy failed."
        schedule_clipboard_clear "$1" xsel
    else
        die "Install wl-clipboard, xclip, or xsel for clipboard support."
    fi
}

copy_clipboard() {
    printf '%s' "$1" > "$WORK/clipboard" ||
        die "Cannot prepare clipboard data."
    copy_clipboard_file "$WORK/clipboard"
}

copy_entry() {
    copy_field=password
    spec=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -u|--username) copy_field=username ;;
            -p|--password) copy_field=password ;;
            -n|--notes) copy_field=notes ;;
            -l|--url) copy_field=url ;;
            --*) die "Unknown copy option: $1" ;;
            *) [ -z "$spec" ] || die "Only one entry may be specified."
               spec=$1 ;;
        esac
        shift
    done
    [ -n "$spec" ] ||
        die "Usage: pass copy [--username|-u|--password|-p|--notes|-n|--url|-l] TITLE/USERNAME"
    decrypt_db
    parse_spec "$spec"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    case "$copy_field" in
        username) copy_file=$WORK/f2 ;;
        password) copy_file=$WORK/f3 ;;
        url) copy_file=$WORK/url ;;
        notes) copy_file=$WORK/notes ;;
    esac
    copy_clipboard_file "$copy_file"
    # Copying is active use; extend the five-minute cache timeout.
    cache_touch
    printf '%s copied to clipboard.\n' "$copy_field"
}

print_identifiers() {
    LC_ALL=C awk '
    NR==1 {next}
    {
        field=1; escaped=0; first=""; second=""
        for (i=1; i<=length($0) && field<=2; i++) {
            c=substr($0,i,1)
            if (escaped) {
                if (c=="n") value="\n"
                else if (c=="r") value="\r"
                else if (c=="t") value="\t"
                else if (c=="\\" || c=="|") value=c
                else value="\\" c
                if (field==1) first=first value
                else second=second value
                escaped=0
            } else if (c=="\\") escaped=1
            else if (c=="|") field++
            else if (field==1) first=first c
            else second=second c
        }
        if (first !~ /[\r\n\t]/ && second !~ /[\r\n\t]/)
            printf "%s/%s\n",first,second
    }' "$WORK/database"
}
delete_entry() {
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    printf 'Delete %s/%s? [y/N] ' "$title" "$username"
    IFS= read -r answer || answer=
    case "$answer" in
        y|Y|yes|YES) ;;
        *) printf 'Cancelled.\n'; return 0 ;;
    esac
    remove_record "$(encode_value "$title")" "$(encode_value "$username")"
    encrypt_db "$WORK/updated" || die "GPG symmetric encryption failed."
    printf 'Entry deleted.\n'
}

otp_entry() {
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    [ -n "$totp" ] || die "No TOTP secret stored."
    [ -x "$PASS_DIR/totp" ] ||
        die "TOTP helper not found or not executable: $PASS_DIR/totp"
    code=$("$PASS_DIR/totp" "$totp") || die "TOTP generation failed."
    [ -n "$code" ] || die "No TOTP code generated."
    copy_clipboard "$code"
    printf 'TOTP copied to clipboard.\n'
}

otp_add() {
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    if [ -n "$totp" ]; then
        ask_yes_no 'TOTP already exists. Replace it?' || die 'Cancelled.'
    fi
    read_secret 'New TOTP secret: '
    [ -n "$secret" ] || die "TOTP secret cannot be empty."
    totp=$secret
    store_record
    printf 'TOTP secret saved.\n'
}

otp_remove() {
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    [ -n "$totp" ] || die "No TOTP secret exists."
    ask_yes_no "Remove TOTP from $title/$username?" || die "Cancelled."
    totp=
    store_record
    printf 'TOTP secret removed.\n'
}

qr_entry() {
    [ "$#" -eq 1 ] || usage
    decrypt_db
    parse_spec "$1"
    record=$(find_entry)
    [ -n "$record" ] || die "Entry not found."
    decode_record "$record"
    [ -x "$PASS_DIR/qr" ] ||
        die "QR helper not found or not executable: $PASS_DIR/qr"
    "$PASS_DIR/qr" "$password"
}

command_name=${1:-}
[ "$#" -gt 0 ] && shift
case "$command_name" in
    init) init_db "$@" ;;
    open) open_db "$@" ;;
    close|lock) close_db "$@" ;;
    rekey) rekey_db "$@" ;;
    add) [ "$#" -eq 0 ] || usage; add_entry ;;
    edit) edit_entry "$@" ;;
    show) show_entry "$@" ;;
    copy) copy_entry "$@" ;;
    delete) delete_entry "$@" ;;
    qr) qr_entry "$@" ;;
    generate|gen) generate_password "$@" ;;
    otp)
        case "${1:-}" in
            add) shift; otp_add "$@" ;;
            remove) shift; otp_remove "$@" ;;
            *) otp_entry "$@" ;;
        esac
        ;;
    *) usage ;;
esac
